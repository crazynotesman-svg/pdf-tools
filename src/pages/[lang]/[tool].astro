---
/**
 * Dynamic tool page — one route generates (locale × tool) = 24 pages.
 *
 * Phase 2.2.2 conversion-optimized order:
 *   ToolHero → TrustPanel → Large upload panel (PdfDropZone) → AdSlot(top)
 *   → Feature highlights (ToolFeatures) → How it works (HowItWorks)
 *   → SEO article (SeoContent) → AdSlot(middle) → Related tools
 *   → Tool FAQ (ToolFaq) → AdSlot(footer)
 *
 * Everything is data-driven from the content entry; the Astro page only
 * passes (operation, locale) to the island. No PDF logic lives here.
 */
import type { GetStaticPaths } from 'astro';
import { locales, type Locale } from '@/i18n/config';
import { t } from '@/i18n/ui';
import { getCollection, type CollectionEntry } from 'astro:content';
import { getToolPath } from '@/lib/tools/router';
import BaseLayout from '@/components/layout/BaseLayout.astro';
import ToolHero from '@/components/ui/ToolHero.astro';
import TrustPanel from '@/components/ui/TrustPanel.astro';
import SeoContent from '@/components/ui/SeoContent.astro';
import RelatedTools from '@/components/ui/RelatedTools.astro';
import ToolClusterNav from '@/components/ui/ToolClusterNav.astro';
import ToolFeatures from '@/components/ui/ToolFeatures.astro';
import ToolFaq from '@/components/ui/ToolFaq.astro';
import ToolBlogLinks from '@/components/ui/ToolBlogLinks.astro';
import HowItWorks from '@/components/ui/HowItWorks.astro';
import AdSlot from '@/components/ui/AdSlot.astro';
import PdfDropZone from '@/components/ui/PdfDropZone.tsx';

export const getStaticPaths = (async () => {
  const tools = await getCollection('tools');
  const paths: { params: { lang: string; tool: string }; props: { locale: Locale; tool: CollectionEntry<'tools'> } }[] =
    [];
  for (const locale of locales) {
    for (const tool of tools) {
      paths.push({
        params: { lang: locale, tool: tool.data.slug[locale] },
        props: { locale, tool },
      });
    }
  }
  return paths;
}) satisfies GetStaticPaths;

interface Props {
  locale: Locale;
  tool: CollectionEntry<'tools'>;
}

const { locale, tool } = Astro.props;
const slug = tool.data.slug[locale];
const toolUrl = getToolPath(locale, slug);
const tl = (key: Parameters<typeof t>[1]) => t(locale, key);

const breadcrumb = [
  { name: tl('common.home'), url: `/${locale}` },
  { name: tl('common.menu.tools'), url: `/${locale}#tools` },
  { name: tool.data.content[locale].h1, url: toolUrl },
];
---

<BaseLayout locale={locale} tool={tool} breadcrumb={breadcrumb}>
  <ToolHero tool={tool} locale={locale} />

  {/* Trust signals right under the hero */}
  <div class="py-4">
    <TrustPanel locale={locale} />
  </div>

  {/* ===== Large upload panel (browser-side PDF handling) ===== */}
  <section class="container-page py-8">
    <PdfDropZone operation={tool.data.toolType} locale={locale} client:visible />
  </section>

  {/* Ad placement: below the upload panel */}
  <AdSlot position="top" />

  {/* Feature highlights + benefits + limitations (Phase 2.2 schema) */}
  <div class="py-8">
    <ToolFeatures tool={tool} locale={locale} />
  </div>

  {/* How it works */}
  <div class="py-8">
    <HowItWorks locale={locale} />
  </div>

  {/* Long-form SEO article body (locale-filtered) */}
  <SeoContent tool={tool} locale={locale} />

  {/* Ad placement: inside the content area */}
  <AdSlot position="middle" />

  {/* Same-cluster group (data-driven via toolCluster) — Phase 3.2.2 */}
  <div class="py-8">
    <ToolClusterNav cluster={tool.data.toolCluster} currentTool={tool.data.id} locale={locale} />
  </div>

  {/* Internal cross-links (ids resolved by RelatedTools) */}
  <section class="container-page py-8">
    <RelatedTools
      relatedToolIds={tool.data.relatedTools}
      recommendedToolIds={tool.data.recommendedTools}
      locale={locale}
    />
  </section>

  {/* Related blog articles (content loop: Tool → Blog) — Phase 3.2.5 */}
  <ToolBlogLinks
    relatedBlogPosts={tool.data.relatedBlogPosts}
    toolType={tool.data.toolType}
    locale={locale}
  />

  {/* Visible FAQ (mirrors FAQPage JSON-LD) */}
  <ToolFaq tool={tool} locale={locale} />

  {/* Ad placement: near the footer */}
  <AdSlot position="footer" />
</BaseLayout>

{/* Delegated click instrumentation for the Tool → Blog article cards
    (Phase 3.2.5.1). Aggregate params only (toolType, article slug, locale) —
    never file names or content. noop provider short-circuits everything. */}
<script>
  import { trackEvent, EVENTS } from '@/lib/analytics';

  const locale = window.location.pathname.split('/')[1] || 'de';
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const el = target.closest('[data-analytics="tool_blog_article"]') as HTMLElement | null;
    if (!el) return;
    trackEvent(EVENTS.clickToolBlogArticle, {
      tool: el.getAttribute('data-tool') ?? '',
      article: el.getAttribute('data-article') ?? '',
      locale,
    });
  });
</script>
