---
/**
 * Landing page — the SEO entry point for each locale (e.g. /de).
 *
 * Phase 2.2.1 SaaS structure:
 *   Hero (badge · H1 · subtitle · CTA) → Trust (TrustPanel) → Popular tools
 *   (collection-driven grid) → Categories → How it works → Security → FAQ →
 *   CTA footer.
 *
 * Nothing about the individual tools is hard-coded: the tool grid and the
 * category grouping are both derived from getCollection('tools'). All visible
 * copy comes from i18n (home.*).
 */
import type { GetStaticPaths } from 'astro';
import { locales } from '@/i18n/config';
import { t, getDictionary } from '@/i18n/ui';
import { getCollection } from 'astro:content';
import { getToolPath } from '@/lib/tools/router';
import type { ToolEntry } from '@/lib/tools/router';
import BaseLayout from '@/components/layout/BaseLayout.astro';
import ToolIcon from '@/components/ui/ToolIcon.astro';
import TrustPanel from '@/components/ui/TrustPanel.astro';
import HowItWorks from '@/components/ui/HowItWorks.astro';

export const getStaticPaths = (async () => {
  const tools = await getCollection('tools');
  return locales.map((locale) => ({
    params: { lang: locale },
    props: { locale, tools },
  }));
}) satisfies GetStaticPaths;

const { locale, tools } = Astro.props;
const dict = getDictionary(locale);
const tl = (key: Parameters<typeof t>[1]) => t(locale, key);

// Featured-first ordering (Phase 3.2.2): `priority` ASC, `popular` flagged.
const sortedTools = [...tools].sort((a, b) => (a.data.priority ?? 99) - (b.data.priority ?? 99));

// Group tools by their operation family (toolType) for the hero tagline.
type ToolType = ToolEntry['data']['toolType'];
const grouped = tools.reduce<Record<ToolType, ToolEntry[]>>((acc, tool) => {
  const type = tool.data.toolType;
  (acc[type] ??= []).push(tool);
  return acc;
}, {} as Record<ToolType, ToolEntry[]>);
const categoryOrder = Object.keys(grouped) as ToolType[];

// Semantic cluster grouping for the "browse by category" section (Phase 3.4.0):
// four horizontal category cards (organize/convert/optimize/secure) instead of
// eight stacked single-tool rows. Labels come from toolCluster.categories.*.
type ClusterId = 'organize' | 'convert' | 'optimize' | 'secure';
const CLUSTER_ORDER: ClusterId[] = ['organize', 'convert', 'optimize', 'secure'];
const clusterTools = (cluster: string) => tools.filter((tool) => tool.data.toolCluster === cluster);

const tagline = categoryOrder.map((type) => t(locale, `categories.${type}`)).join(' · ');
const breadcrumb = [{ name: tl('common.home'), url: `/${locale}` }];
---
<BaseLayout
  locale={locale}
  title={tl('home.title')}
  description={tl('home.subtitle')}
  breadcrumb={breadcrumb}
>
  {/* ===== Hero ===== */}
  <section class="bg-tech relative flex min-h-[680px] items-center justify-center overflow-hidden">
    <div class="hero-glow pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div
      class="float pointer-events-none absolute -right-16 top-24 -z-0 h-64 w-64 rounded-full bg-gradient-to-br from-neon-blue/20 to-electric-purple/20 blur-3xl"
      aria-hidden="true"
    ></div>
    <div
      class="float pointer-events-none absolute -left-16 bottom-16 -z-0 h-48 w-48 rounded-full bg-gradient-to-br from-accent/20 to-neon-blue/20 blur-3xl"
      style="animation-delay:-3s"
      aria-hidden="true"
    ></div>
    <div class="container-page relative z-10 py-24 text-center">
      <div
        class="mb-6 inline-flex items-center gap-2 rounded-full border border-border-subtle bg-white/70 px-4 py-1.5 text-label-caps uppercase text-on-surface-variant backdrop-blur"
      >
        <span class="text-neon-blue">✨</span>
        <span>{tl('home.eyebrow')}</span>
      </div>
      <h1 class="mx-auto max-w-4xl text-5xl font-bold tracking-tight md:text-7xl">
        <span class="text-gradient">{tl('home.title')}</span>
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-on-surface-variant md:text-xl">
        {tl('home.subtitle')}
      </p>
      <p class="mx-auto mt-4 text-sm font-medium uppercase tracking-wide text-on-surface-variant/70">
        {tagline}
      </p>
      <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href={`#tools`} class="btn-primary-modern inline-flex items-center gap-2 px-8 py-4 text-lg">
          {tl('home.cta')}
          <span>→</span>
        </a>
      </div>
      <p class="mt-6 text-sm text-on-surface-variant">
        <span class="font-semibold text-neon-blue">✓</span> {tl('home.securityHeading')}
      </p>
    </div>
  </section>

  {/* ===== Trust ===== */}
  <div class="relative z-10 -mt-10">
    <TrustPanel locale={locale} />
  </div>

  {/* ===== Popular tools (collection-driven) ===== */}
  <section id="tools" class="container-page py-16">
    <div class="mb-10 flex flex-col gap-2 text-left">
      <h2 class="font-headline-lg text-headline-lg text-on-surface">{tl('home.popularHeading')}</h2>
      <p class="text-on-surface-variant">{tl('home.popularSubheading')}</p>
    </div>
    <ul class="grid gap-gutter sm:grid-cols-2 lg:grid-cols-4">
      {
        sortedTools.map((tool) => {
          const url = getToolPath(locale, tool.data.slug[locale]);
          const content = tool.data.content[locale];
          const seo = tool.data.seo[locale];
          return (
            <li>
              <a
                href={url}
                data-analytics="tool_card"
                data-tool={tool.data.toolType}
                class="tool-card group relative flex h-full flex-col p-8"
              >
                {tool.data.popular && (
                  <span class="absolute right-5 top-5 inline-flex items-center rounded-full bg-gradient-to-r from-neon-blue to-electric-purple px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-wide text-white">
                    {tl('popular.badge')}
                  </span>
                )}
                <div class="icon-box mb-6 transition-transform duration-300 group-hover:scale-105">
                  <ToolIcon toolType={tool.data.toolType} class="h-8 w-8" />
                </div>
                <h3 class="mb-3 font-title-md text-title-md text-on-surface">{content.h1}</h3>
                <p class="mb-6 flex-1 text-sm leading-relaxed text-on-surface-variant">{seo.description}</p>
                <span class="inline-flex items-center gap-1 font-code-sm text-xs uppercase tracking-wider text-neon-blue transition-all group-hover:gap-2">
                  {tl('home.cta')}
                  <span>→</span>
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>

  {/* ===== Categories (semantic clusters, horizontal cards — Phase 3.4.0) ===== */}
  <section id="categories" class="container-page py-16">
    <h2 class="font-headline-lg text-headline-lg text-on-surface">{tl('home.categoriesHeading')}</h2>
    <div class="mt-6 grid grid-cols-2 gap-4 lg:grid-cols-4">
      {
        CLUSTER_ORDER.map((cluster) => {
          const items = clusterTools(cluster);
          if (items.length === 0) return null;
          return (
            <div class="glass-card flex flex-col rounded-2xl border border-border-subtle p-5">
              <h3 class="text-xs font-semibold uppercase tracking-wider text-on-surface-variant">
                {t(locale, `toolCluster.categories.${cluster}`)}
              </h3>
              <ul class="mt-3 flex-1 space-y-1">
                {items.map((tool) => (
                  <li>
                    <a
                      href={getToolPath(locale, tool.data.slug[locale])}
                      data-analytics="category"
                      data-category={tool.data.toolType}
                      class="group flex items-center justify-between gap-2 rounded-lg px-3 py-2 text-sm font-medium text-on-surface transition-colors hover:bg-neon-blue/5 hover:text-neon-blue"
                    >
                      {tool.data.content[locale].h1}
                      <span
                        aria-hidden="true"
                        class="text-on-surface-variant/50 transition-transform group-hover:translate-x-0.5 group-hover:text-neon-blue"
                      >
                        →
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          );
        })
      }
    </div>
  </section>

  {/* ===== How it works ===== */}
  <div class="py-16">
    <HowItWorks locale={locale} />
  </div>

  {/* ===== Security / privacy note ===== */}
  <section id="security" class="container-page py-16">
    <div class="glass-card rounded-3xl border border-border-subtle p-8">
      <div class="mb-4 flex items-center gap-2 text-neon-blue">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"
          ><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /><path d="m9 12 2 2 4-4" /></svg
        >
        <h2 class="font-headline-lg text-headline-lg text-on-surface">{tl('home.securityHeading')}</h2>
      </div>
      <p class="text-on-surface-variant">{tl('home.securityNote')}</p>
    </div>
  </section>

  {/* ===== Site-level FAQ ===== */}
  <section id="faq" class="container-page py-16">
    <h2 class="mb-10 text-center font-headline-lg text-headline-lg text-on-surface">
      {tl('home.faqHeading')}
    </h2>
    <div class="mx-auto max-w-4xl space-y-4">
      {
        dict.home.faq.map((item) => (
          <details class="glass-card group overflow-hidden rounded-2xl border border-border-subtle" open>
            <summary class="flex cursor-pointer list-none items-center justify-between p-6 font-medium text-on-surface">
              {item.question}
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="h-5 w-5 text-on-surface-variant transition-transform group-open:rotate-180"
              >
                <path d="m6 9 6 6 6-6" />
              </svg>
            </summary>
            <div class="border-t border-border-subtle p-6 pt-0 text-on-surface-variant">
              {item.answer}
            </div>
          </details>
        ))
      }
    </div>
  </section>

  {/* ===== CTA footer ===== */}
  <section class="container-page pb-20 pt-8">
    <div class="bg-tech relative overflow-hidden rounded-3xl border border-border-subtle px-8 py-16 text-center">
      <div class="hero-glow pointer-events-none absolute inset-0" aria-hidden="true"></div>
      <h2 class="relative font-headline-lg text-headline-lg text-on-surface">{tl('home.ctaFooterHeading')}</h2>
      <p class="relative mx-auto mt-3 max-w-xl text-on-surface-variant">{tl('home.ctaFooterText')}</p>
      <div class="relative mt-8">
        <a href={`#tools`} class="btn-primary-modern inline-flex items-center gap-2 px-8 py-4 text-lg">
          {tl('home.cta')}
          <span>→</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

{/* Delegated click instrumentation for tool cards + categories (3.1.1).
    Client-only; aggregate params only (locale, tool type / category). */}
<script>
  import { trackEvent, EVENTS } from '@/lib/analytics';

  const locale = window.location.pathname.split('/')[1] || 'de';
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const el = target.closest('[data-analytics]') as HTMLElement | null;
    if (!el) return;
    const kind = el.getAttribute('data-analytics');
    if (kind === 'tool_card') {
      trackEvent(EVENTS.clickToolCard, { locale, tool: el.getAttribute('data-tool') ?? '' });
    } else if (kind === 'category') {
      trackEvent(EVENTS.clickCategory, { locale, category: el.getAttribute('data-category') ?? '' });
    }
  });
</script>
