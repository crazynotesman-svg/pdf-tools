---
/**
 * Blog post page — renders one article (T7).
 *
 * Articles are language-separated files, so this page resolves the current
 * locale + slug, renders the Markdown body, and emits:
 *   - a breadcrumb (Home > Blog > Title)
 *   - blog-aware hreflang alternates via translationKey (BaseLayout `alternateUrls`)
 *   - BlogPosting JSON-LD (BlogPostSchema)
 *   - meta (date / author / tags), an ad slot, and a back-to-blog link.
 *
 * No PDF or other business logic is imported — pure content presentation.
 */
import type { GetStaticPaths } from 'astro';
import { render, getCollection, type CollectionEntry } from 'astro:content';
import { locales, type Locale } from '@/i18n/config';
import { t } from '@/i18n/ui';
import { getBCP47 } from '@/i18n/utils';
import BaseLayout from '@/components/layout/BaseLayout.astro';
import BlogPostSchema from '@/components/seo/BlogPostSchema.astro';
import AdSlot from '@/components/ui/AdSlot.astro';
import {
  getBlogPosts,
  getBlogSlug,
  getBlogPath,
  getBlogAlternateUrls,
} from '@/lib/blog/router';

export const getStaticPaths = (async () => {
  const paths = [];
  for (const lang of locales) {
    const posts = await getBlogPosts(lang);
    for (const post of posts) {
      paths.push({
        params: { lang, slug: getBlogSlug(post) },
        props: { post },
      });
    }
  }
  return paths;
}) satisfies GetStaticPaths;

interface Props {
  post: CollectionEntry<'blog'>;
}
const { post }: Props = Astro.props;
const locale = Astro.params.lang as Locale;
const slug = Astro.params.slug!;
const data = post.data;

const { Content } = await render(post);

const canonicalPath = getBlogPath(locale, slug);
const alternates = await getBlogAlternateUrls(post);
const altMap = Object.fromEntries(alternates.map((a) => [a.locale, a.url])) as Partial<
  Record<Locale, string>
>;

const dateFmt = new Intl.DateTimeFormat(getBCP47(locale), {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Locale-scoped tool path → toolType map (build-time, data-driven) used by the
// delegated CTA instrumentation below (Phase 3.2.3.8).
const tools = await getCollection('tools');
const toolPathMap: Record<string, string> = {};
for (const tool of tools) {
  toolPathMap[`/${locale}/${tool.data.slug[locale]}`] = tool.data.toolType;
}

const breadcrumb = [
  { name: t(locale, 'common.home'), url: `/${locale}` },
  { name: t(locale, 'common.menu.blog'), url: `/${locale}/blog` },
  { name: data.title, url: canonicalPath },
];
---
<BaseLayout
  locale={locale}
  title={data.title}
  description={data.description}
  breadcrumb={breadcrumb}
  alternateUrls={altMap}
>
  <BlogPostSchema post={post} locale={locale} url={canonicalPath} />

  <article class="container-page py-12">
    <header class="max-w-3xl">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-on-surface-variant">
        <time datetime={data.pubDate.toISOString()}>
          {t(locale, 'blog.publishedOn')} {dateFmt.format(data.pubDate)}
        </time>
        <span aria-hidden="true">·</span>
        <span>{t(locale, 'blog.by')} {data.author}</span>
      </div>
      <h1 class="mt-3 font-headline-lg text-headline-lg text-on-surface sm:text-4xl">{data.title}</h1>
      <p class="mt-4 text-lg text-on-surface-variant">{data.description}</p>
      {
        data.tags.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-2">
            {data.tags.map((tag) => (
              <span class="rounded-full bg-surface-container-high px-2.5 py-0.5 text-xs text-on-surface-variant">{tag}</span>
            ))}
          </div>
        )
      }
    </header>

    <AdSlot position="top" />

    <div class="article-body mt-8 max-w-3xl">
      <Content />
    </div>

    {
      data.updatedDate && (
        <p class="mt-8 max-w-3xl text-sm text-on-surface-variant/70">
          {t(locale, 'blog.updatedOn')} {dateFmt.format(data.updatedDate)}
        </p>
      )
    }

    <AdSlot position="footer" />

    <a
      href={`/${locale}/blog`}
      class="mt-10 inline-flex items-center gap-1 text-sm font-medium text-neon-blue hover:underline"
    >
      ← {t(locale, 'blog.backToBlog')}
    </a>
  </article>
</BaseLayout>

{/* Build-time tool path → toolType map for the CTA instrumentation below.
    Plain JSON payload (not a JS script) — no client processing, no escaping
    surprises. Read at runtime by the bundled script. */}
<script type="application/json" id="blog-cta-map" is:inline set:html={JSON.stringify(toolPathMap)} />

{/* Delegated CTA instrumentation for tool links inside the article body
    (Phase 3.2.3.8). Data-driven: the path→toolType map is built from the tools
    collection at build time. Aggregate params only (article slug, tool type,
    locale) — never file names or content. */}
<script>
  import { trackEvent, EVENTS } from '@/lib/analytics';

  const locale = window.location.pathname.split('/')[1] || 'de';
  const article = window.location.pathname.split('/')[3] || '';
  const payload = document.getElementById('blog-cta-map');
  const toolPathMap: Record<string, string> = payload ? JSON.parse(payload.textContent ?? '{}') : {};

  document.querySelector('.article-body')?.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const anchor = target.closest('a') as HTMLAnchorElement | null;
    if (!anchor) return;
    const path = anchor.pathname.replace(/\/$/, '');
    const tool = toolPathMap[path];
    if (!tool) return;
    trackEvent(EVENTS.clickBlogToolCta, { article, tool, locale });
  });
</script>
