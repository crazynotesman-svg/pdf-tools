---
/**
 * Analytics.astro — injects the analytics provider script (Phase 3.1.1).
 *
 * Controlled by `PUBLIC_ANALYTICS_PROVIDER`:
 *   - (unset) | `none` → renders NOTHING (zero script, zero CWV impact)
 *   - `plausible` → async/defer plausible.io script with data-domain
 *   - `umami` / `ga4` → reserved (need their env values to activate)
 *
 * Additional env:
 *   PUBLIC_PLAUSIBLE_DOMAIN (defaults to Astro.site host)
 *   PUBLIC_UMAMI_SRC / PUBLIC_UMAMI_WEBSITE_ID
 *   PUBLIC_GA4_MEASUREMENT_ID
 *
 * Plausible is privacy-first: no cookies, no personal data, ~1KB, and the
 * script is async+defer so it never blocks rendering.
 */
const provider = (import.meta.env.PUBLIC_ANALYTICS_PROVIDER as string | undefined) ?? 'none';
const site = Astro.site ?? new URL('https://pdf-tools.example.com');
const plausibleDomain = (import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN as string | undefined) ?? site.host;
const umamiSrc = import.meta.env.PUBLIC_UMAMI_SRC as string | undefined;
const umamiId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID as string | undefined;
const ga4Id = import.meta.env.PUBLIC_GA4_MEASUREMENT_ID as string | undefined;
---

{provider === 'plausible' && (
  <script is:inline defer data-domain={plausibleDomain} src="https://plausible.io/js/script.js"></script>
)}

{provider === 'umami' && umamiSrc && umamiId && (
  <script is:inline async defer src={umamiSrc} data-website-id={umamiId}></script>
)}

{provider === 'ga4' && ga4Id && (
  <>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`}></script>
    <script is:inline>{`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${ga4Id}');`}</script>
  </>
)}
