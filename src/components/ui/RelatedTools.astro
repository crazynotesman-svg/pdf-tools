---
/**
 * RelatedTools.astro — internal cross-links on a tool page.
 *
 * Per project decision (#7): the content field `relatedTools` stays a plain
 * list of tool ids (no nested objects) to keep authoring simple. This
 * component resolves each id to its localized name + URL at render time via
 * the router helpers. No hard-coded tool facts.
 */
import type { Locale } from '@/i18n/config';
import { t } from '@/i18n/ui';
import { getToolById, getToolUrl } from '@/lib/tools/router';

interface Props {
  relatedToolIds: string[];
  locale: Locale;
}

const { relatedToolIds, locale } = Astro.props;

const items = await Promise.all(
  relatedToolIds.map(async (id) => {
    const entry = await getToolById(id);
    return {
      id,
      name: entry ? entry.data.content[locale].h1 : id,
      url: await getToolUrl(id, locale),
    };
  })
);
---

<section class="related-tools" aria-label="Related tools">
  <h2 class="mb-4 font-headline-lg text-headline-lg text-on-surface">{t(locale, 'home.toolsHeading')}</h2>
  <ul class="related-tools__list flex flex-wrap gap-3">
    {
      items.map((it) => (
        <li>
          <a
            href={it.url}
            class="glass-panel inline-flex items-center gap-1 rounded-full border border-border-subtle px-4 py-1.5 text-sm text-on-surface-variant transition-colors hover:text-neon-blue"
          >
            {it.name}
          </a>
        </li>
      ))
    }
  </ul>
</section>
