---
/**
 * ToolBlogLinks.astro — "Related articles" section on a tool page (Phase 3.2.5).
 *
 * Completes the content loop: Blog → Tool (already exists via blog CTAs) and
 * Tool → Blog (this section). Reads the tool's `relatedBlogPosts` translationKeys,
 * resolves them to the current locale's articles via the blog router (same
 * translationKey mechanism used for hreflang), and renders article cards.
 *
 * Data-driven: nothing hard-coded. If none of the keys resolve for the active
 * locale (e.g. missing translation), the component renders nothing — no empty
 * container. Cards carry data-tool/data-article attributes for the delegated
 * `click_tool_blog_article` instrumentation on the tool page.
 */
import type { Locale } from '@/i18n/config';
import { t } from '@/i18n/ui';
import { getBlogPosts, getBlogPath } from '@/lib/blog/router';

interface Props {
  locale: Locale;
  /** Blog translationKeys from the tool's `relatedBlogPosts` frontmatter. */
  relatedBlogPosts: string[];
  /** toolType for analytics params. */
  toolType: string;
}

const { locale, relatedBlogPosts, toolType } = Astro.props;
const tl = (key: Parameters<typeof t>[1]) => t(locale, key);

const wanted = new Set(relatedBlogPosts);
const posts = (await getBlogPosts(locale)).filter((p) => wanted.has(p.data.translationKey));

if (posts.length === 0) {
  return null;
}
---

<section class="container-page py-8" aria-label={tl('toolPage.blogHeading')}>
  <h2 class="mb-6 font-headline-lg text-headline-lg text-on-surface">{tl('toolPage.blogHeading')}</h2>
  <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {
      posts.map((post) => {
        const slug = post.id.split('/')[1] ?? post.id;
        const url = getBlogPath(locale, slug);
        return (
          <li>
            <a
              href={url}
              data-analytics="tool_blog_article"
              data-tool={toolType}
              data-article={slug}
              class="glass-card flex h-full flex-col rounded-xl border border-border-subtle p-5 transition-all duration-300 hover:-translate-y-0.5 hover:border-neon-blue/40 hover:shadow-md"
            >
              <span class="text-sm font-semibold leading-snug text-on-surface group-hover:text-neon-blue">{post.data.title}</span>
              <span class="mt-2 line-clamp-2 flex-1 text-xs leading-relaxed text-on-surface-variant">{post.data.description}</span>
              <span class="mt-3 inline-flex items-center gap-1 text-xs font-medium text-neon-blue">
                {tl('blog.readMore')}
                <span aria-hidden="true">→</span>
              </span>
            </a>
          </li>
        );
      })
    }
  </ul>
</section>
