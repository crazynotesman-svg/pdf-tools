---
/**
 * ToolFeatures — renders a tool's structured `features` / `benefits` /
 * `limitations` blocks (Phase 2.2.4 schema) for the active locale.
 * Presentation only: reads tool.data, nothing hard-coded.
 */
import type { Locale } from '@/i18n/config';
import type { CollectionEntry } from 'astro:content';
import { t } from '@/i18n/ui';

interface Props {
  tool: CollectionEntry<'tools'>;
  locale: Locale;
}

const { tool, locale } = Astro.props;
const data = tool.data;
const tl = (key: Parameters<typeof t>[1]) => t(locale, key);
const features = data.features[locale];
const benefits = data.benefits[locale];
const limitations = data.limitations[locale];
---
<section class="container-page" aria-label={tl('toolPage.featuresHeading')}>
  {/* Feature highlights */}
  <div class="rounded-3xl border border-border-subtle bg-surface-container-low p-8">
    <h2 class="font-headline-lg text-headline-lg text-on-surface">{tl('toolPage.featuresHeading')}</h2>
    <ul class="mt-6 grid gap-4 sm:grid-cols-2">
      {
        features.map((f) => (
          <li class="flex items-start gap-3 rounded-2xl border border-border-subtle bg-white/70 p-5">
            <span class="mt-0.5 grid h-8 w-8 shrink-0 place-items-center rounded-lg bg-gradient-to-br from-neon-blue/10 to-electric-purple/10 text-neon-blue">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
            </span>
            <span>
              <span class="block font-medium text-on-surface">{f.title}</span>
              <span class="mt-1 block text-sm leading-relaxed text-on-surface-variant">{f.text}</span>
            </span>
          </li>
        ))
      }
    </ul>

    {benefits.length > 0 && (
      <ul class="mt-8 grid gap-x-8 gap-y-3 sm:grid-cols-2">
        {benefits.map((b) => (
          <li class="flex items-start gap-2 text-sm text-on-surface-variant">
            <span class="mt-0.5 text-neon-blue">→</span>
            <span>
              <span class="font-medium text-on-surface">{b.title}: </span>
              {b.text}
            </span>
          </li>
        ))}
      </ul>
    )}
  </div>

  {/* Honest limitations */}
  {limitations.length > 0 && (
    <div class="mt-6 rounded-2xl border border-amber-200 bg-amber-50/60 p-6">
      <h3 class="text-base font-semibold text-on-surface">{tl('toolPage.limitationsHeading')}</h3>
      <ul class="mt-3 space-y-2">
        {limitations.map((l) => (
          <li class="flex items-start gap-2 text-sm leading-relaxed text-on-surface-variant">
            <span class="mt-0.5 text-amber-600">•</span>
            <span>
              <span class="font-medium text-on-surface">{l.title}: </span>
              {l.text}
            </span>
          </li>
        ))}
      </ul>
    </div>
  )}
</section>
