---
/**
 * Footer — legal + contact links, all sourced from i18n (no hard-coded text).
 *
 * Composition only: every label comes from the UI dictionary; every link is a
 * locale-prefixed static route. Per T5 #3 the footer exposes Datenschutz,
 * Impressum and Kontakt (privacy / imprint / contact).
 *
 * Restyled to a premium SaaS footer: dark slate surface, soft gray text.
 */
import type { Locale } from '@/i18n/config';
import { t } from '@/i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const year = new Date().getFullYear();
const links = [
  { label: t(locale, 'common.menu.privacy'), href: `/${locale}/privacy` },
  { label: t(locale, 'common.menu.imprint'), href: `/${locale}/impressum` },
  { label: t(locale, 'common.menu.contact'), href: `/${locale}/contact` },
];
---
<footer class="mt-20 border-t border-white/10 bg-slate-950">
  <div
    class="container-page flex flex-col gap-6 py-10 sm:flex-row sm:items-start sm:justify-between"
  >
    <div class="flex flex-col gap-2">
      <div class="flex items-center gap-2">
        <span class="grid h-7 w-7 place-items-center rounded-xl bg-gradient-to-br from-neon-blue to-electric-purple text-sm font-bold text-white">✦</span>
        <span class="font-semibold tracking-tight text-white">{t(locale, 'common.siteName')}</span>
      </div>
      <p class="max-w-xs text-sm text-slate-400">{t(locale, 'common.tagline')}</p>
    </div>

    <nav class="flex flex-wrap gap-5 text-sm" aria-label="Footer">
      {
        links.map((l) => (
          <a href={l.href} class="text-slate-400 transition-colors hover:text-white">
            {l.label}
          </a>
        ))
      }
    </nav>
  </div>
  <div class="container-page flex flex-col gap-1 pb-8 text-xs text-slate-500">
    <span>© {year} {t(locale, 'common.siteName')}. {t(locale, 'footer.rights')}</span>
    <span>{t(locale, 'footer.note')}</span>
  </div>
</footer>
