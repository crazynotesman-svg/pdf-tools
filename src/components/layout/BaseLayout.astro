---
/**
 * BaseLayout — pure composition root for every page.
 *
 * Responsibilities (per T5 #1): HTML document structure, <head>, SEO components,
 * Header/Footer. It contains NO tool business logic — it only wires together
 * the pieces handed to it via props.
 *
 * - Tool pages pass `tool` + `locale`: we delegate head + structured data to the
 *   T4 SEO components (Meta / StructuredData / FaqSchema / HowToSchema).
 * - Generic pages pass `title` + `description`: we emit a minimal head and, for
 *   locale-invariant static pages, a basic hreflang set via T2's
 *   getAlternateUrls (a prefix swap is correct there — only tool slugs differ).
 *
 * The breadcrumb (T4, generic) is optionally injected by the page.
 */
import type { Locale } from '@/i18n/config';
import type { CollectionEntry } from 'astro:content';
import { htmlLang, locales } from '@/i18n/config';
import { t } from '@/i18n/ui';
import { getAlternateUrls } from '@/i18n/utils';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Meta from '@/components/seo/Meta.astro';
import StructuredData from '@/components/seo/StructuredData.astro';
import FaqSchema from '@/components/seo/FaqSchema.astro';
import HowToSchema from '@/components/seo/HowToSchema.astro';
import Breadcrumb from '@/components/seo/Breadcrumb.astro';
import SiteSchema from '@/components/seo/SiteSchema.astro';
import Analytics from '@/components/analytics/Analytics.astro';

// Global stylesheet — Tailwind base/components/utilities + site theme.
// The @astrojs/tailwind integration is configured with applyBaseStyles:false,
// so we MUST import it explicitly here; otherwise no CSS is bundled and the
// pages render as unstyled text. BaseLayout wraps every page, so one import
// covers the whole site.
import '@/styles/global.css';

interface Props {
  locale: Locale;
  /** Present on tool pages; absent on generic pages (home, blog, legal). */
  tool?: CollectionEntry<'tools'>;
  /** Optional breadcrumb trail (e.g. Home > PDF Tools > Current Tool). */
  breadcrumb?: { name: string; url: string }[];
  /** Used by generic pages when no `tool` is provided. */
  title?: string;
  description?: string;
  /**
   * Blog-aware hreflang alternates (paths, no origin). When provided it
   * overrides the generic getAlternateUrls prefix-swap — needed because blog
   * post slugs differ per language and must be resolved via translationKey.
   */
  alternateUrls?: Partial<Record<Locale, string>>;
  /** Optional RSS feed link emitted in <head> (used by the blog index). */
  feed?: { title: string; href: string };
}

const { locale, tool, breadcrumb, title, description, alternateUrls, feed } = Astro.props;
const site = Astro.site ?? new URL('https://pdf-tools.example.com');
const pathname = Astro.url.pathname;

const pageTitle = tool ? tool.data.seo[locale].title : (title ?? t(locale, 'common.siteName'));
const pageDescription = tool ? tool.data.seo[locale].description : (description ?? '');

// Generic pages: locale-invariant slugs → getAlternateUrls (prefix swap) is the
// correct hreflang strategy, unless the page supplies its own blog-aware
// alternate URLs (e.g. blog posts, whose slugs differ per language).
const altMap: Partial<Record<Locale, string>> | null = alternateUrls ?? (tool ? null : getAlternateUrls(pathname));
const xDefaultHref = altMap ? (altMap.de ?? Object.values(altMap)[0] ?? pathname) : pathname;
---
<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* PWA-ready assets (no service worker) — Phase 2.3.6 */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#2563EB" />

    {/* Analytics script injection — renders nothing unless PUBLIC_ANALYTICS_PROVIDER is set */}
    <Analytics />

    {
      tool ? (
        <>
          <Meta tool={tool} locale={locale} />
          <StructuredData tool={tool} locale={locale} />
          <FaqSchema tool={tool} locale={locale} />
          <HowToSchema tool={tool} locale={locale} />
        </>
      ) : (
        <>
          <title>{pageTitle}</title>
          <meta name="description" content={pageDescription} />
          <link rel="canonical" href={new URL(pathname, site).href} />
          {altMap &&
            locales.map((l) =>
              altMap[l] ? (
                <link rel="alternate" hreflang={l} href={new URL(altMap[l]!, site).href} />
              ) : null,
            )}
          {altMap && (
            <link rel="alternate" hreflang="x-default" href={new URL(xDefaultHref, site).href} />
          )}
          {feed && (
            <link
              rel="alternate"
              type="application/rss+xml"
              title={feed.title}
              href={new URL(feed.href, site).href}
            />
          )}
          {/* Site-level WebSite + Organization schema (2.3.1 / 2.3.2) */}
          <SiteSchema locale={locale} />
          <meta property="og:type" content="website" />
          <meta property="og:title" content={pageTitle} />
          <meta property="og:description" content={pageDescription} />
          <meta property="og:url" content={new URL(pathname, site).href} />
        </>
      )
    }

    {breadcrumb && <Breadcrumb items={breadcrumb} />}
  </head>

  <body class="flex min-h-screen flex-col">
    {/* Subtle light ambient glow at the top (SaaS feel, no JS). */}
    <div
      class="pointer-events-none fixed inset-x-0 top-0 -z-10 h-64 bg-gradient-to-b from-neon-blue/5 to-transparent"
      aria-hidden="true"
    >
    </div>
    <Header locale={locale} currentPath={pathname} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />

    {/* Page-view with context — client-only, SSR safe (runs in the browser).
        pageType is inferred from the URL; never blocks rendering. */}
    <script>
      import { trackPageView } from '@/lib/analytics';

      const pathname = window.location.pathname;
      const locale = pathname.split('/')[1] || 'de';
      const pageType = (() => {
        if (/\/blog(\/|$)/.test(pathname)) return 'blog';
        if (/\/(contact|privacy|impressum)(\/|$)/.test(pathname)) return 'legal';
        if (pathname === '/404.html') return 'other';
        return pathname.split('/').filter(Boolean).length >= 2 ? 'tool' : 'home';
      })();
      trackPageView({ locale, pathname, pageType });
    </script>
  </body>
</html>
