---
/**
 * Header — site header with logo, primary navigation and the language switcher.
 *
 * Composition only: it reads system UI strings from i18n and builds links via
 * the current locale. It contains NO tool business logic (no PDF code, no
 * hard-coded tool names). The logo and "Tools" link both point to the localized
 * home/landing page; "Blog" to the localized blog index.
 */
import type { Locale } from '@/i18n/config';
import { t } from '@/i18n/ui';
import LanguageSwitcher from '@/components/ui/LanguageSwitcher.astro';

interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
const homeHref = `/${locale}`;
const nav = [
  { label: t(locale, 'common.menu.tools'), href: homeHref },
  { label: t(locale, 'common.menu.blog'), href: `/${locale}/blog` },
];
---
<header class="border-b border-ink-200 bg-white">
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a href={homeHref} class="flex items-center gap-2 font-semibold text-ink-900">
      <span class="grid h-8 w-8 place-items-center rounded-md bg-brand text-xs font-bold text-white">PDF</span>
      <span>{t(locale, 'common.siteName')}</span>
    </a>

    <nav class="hidden items-center gap-6 sm:flex" aria-label="Primary">
      {
        nav.map((item) => (
          <a href={item.href} class="text-sm font-medium text-ink-700 hover:text-brand">
            {item.label}
          </a>
        ))
      }
    </nav>

    <LanguageSwitcher locale={locale} currentPath={currentPath} />
  </div>
</header>
