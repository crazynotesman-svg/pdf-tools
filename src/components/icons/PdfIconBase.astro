---
/**
 * PdfIconBase — shared SVG skeleton for every PDF tool icon.
 *
 * Unified stroke style: 24×24 viewBox, `currentColor`, stroke-width 2,
 * round caps/joins. Sub-icons only provide their <path> elements via a slot.
 * Sizes (24 / 32 / 48) are controlled by the caller with Tailwind:
 *   h-6 w-6 · h-8 w-8 · h-12 w-12
 * Color is controlled with any `text-*` class.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---
<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  <slot />
</svg>
